<?xml version="1.0" encoding="UTF-8"?>
<!-- S4 leg B probe profile: LOOPBACK-ONLY UDPv4 (cf. shapes/profiles.xml, which
     whitelists the LAN interface too). The probe is rebuilt often and ad-hoc
     signed; the macOS application firewall / local-network privacy layer
     silently drops LAN-sourced inbound UDP for binaries the user has not
     approved (loopback is exempt). Pinning the whitelist to 127.0.0.1 keeps the
     whole exchange on lo0 - the probe announces 127.0.0.1 locators, so every
     peer-to-probe packet rides loopback and the run needs no per-binary
     firewall approval. TypeLookup stays explicitly on (fastdds.type_propagation,
     Fast DDS 3.x: the 2.x typelookup_config element no longer exists). -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastDDS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_loopback_only</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <address>127.0.0.1</address>
        </interfaceWhiteList>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="fastdds_type_probe" is_default_profile="true">
      <rtps>
        <useBuiltinTransports>false</useBuiltinTransports>
        <userTransports>
          <transport_id>udp_loopback_only</transport_id>
        </userTransports>
        <propertiesPolicy>
          <properties>
            <property>
              <name>fastdds.type_propagation</name>
              <value>enabled</value>
            </property>
          </properties>
        </propertiesPolicy>
      </rtps>
    </participant>
  </profiles>
</dds>
