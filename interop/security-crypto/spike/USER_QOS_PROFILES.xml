<?xml version="1.0"?>
<!-- Security QoS for the payload-protection spike.
     Uses ecdsa01 identity certs from the Connext example bundle.
     Governance: data_protection_kind=ENCRYPT / metadata_protection_kind=NONE.
     This is a loopback (lo0) spike: both pub and sub use the same identity. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.1/rti_dds_qos_profiles.xsd">
  <qos_library name="SecuritySpike">
    <qos_profile name="PayloadOnly" is_default_qos="true">
      <participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>
        </transport_builtin>
        <property>
          <value>
            <!-- Use loopback for the spike capture -->
            <element>
              <name>dds.transport.UDPv4.builtin.parent.allow_interfaces</name>
              <value>lo0,127.0.0.1</value>
            </element>
            <!-- Identity certificate + private key (Peer01, ECDSA P-256) -->
            <element>
              <name>com.rti.serv.secure.authentication.ca_file</name>
              <value>$(NDDSHOME)/resource/template/rti_workspace/examples/dds_security/cert/ecdsa01/ca/ecdsa01RootCaCert.pem</value>
            </element>
            <element>
              <name>com.rti.serv.secure.authentication.certificate_file</name>
              <value>$(NDDSHOME)/resource/template/rti_workspace/examples/dds_security/cert/ecdsa01/identities/ecdsa01Peer01Cert.pem</value>
            </element>
            <element>
              <name>com.rti.serv.secure.authentication.private_key_file</name>
              <value>$(NDDSHOME)/resource/template/rti_workspace/examples/dds_security/cert/ecdsa01/identities/ecdsa01Peer01Key.pem</value>
            </element>
            <!-- Governance: payload-only ENCRYPT, metadata NONE -->
            <element>
              <name>com.rti.serv.secure.access_control.governance_file</name>
              <value>file:$(SPIKE_DIR)/signed_governance-payload-only.p7s</value>
            </element>
            <!-- Permissions: allow publish+subscribe on Square -->
            <element>
              <name>com.rti.serv.secure.access_control.permissions_file</name>
              <value>file:$(SPIKE_DIR)/signed_permissions-spike.p7s</value>
            </element>
            <element>
              <name>com.rti.serv.secure.access_control.permissions_authority_file</name>
              <value>$(NDDSHOME)/resource/template/rti_workspace/examples/dds_security/cert/ecdsa01/ca/ecdsa01RootCaCert.pem</value>
            </element>
          </value>
        </property>
      </participant_qos>
    </qos_profile>
  </qos_library>
</dds>
