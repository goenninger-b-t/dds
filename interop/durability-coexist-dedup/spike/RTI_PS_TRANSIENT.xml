<?xml version="1.0" encoding="ISO-8859-1"?>
<!-- RTI Persistence Service config for the WP-DURABILITY-PERSISTENT TRANSIENT-tier coexistence
     leg (the Phase-2 CLOSED_WITH_FINDINGS carry-forward, ADR 0024).
     Loopback-pinned (allow_interfaces=127.0.0.1), domain 0, TRANSIENT in-memory, all topics (*).
     RTI PS relays the TRANSIENT durability tier (NOT TRANSIENT_LOCAL — the Phase-2 blocker), so the
     foreign publisher in this leg advertises TRANSIENT durability (see USER_QOS_PROFILES_TRANSIENT.xml).
     RTPS 2.5 §8.3.5.4 (PID_ORIGINAL_WRITER_INFO 0x0061) is the dedup mechanism under coexistence. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.1/rti_persistence_service.xsd">

  <qos_library name="CoexistenceQosLib">
    <qos_profile name="LoopbackQos">
      <participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>
        </transport_builtin>
        <property>
          <value>
            <element>
              <name>dds.transport.UDPv4.builtin.parent.allow_interfaces</name>
              <value>127.0.0.1</value>
            </element>
          </value>
        </property>
      </participant_qos>
    </qos_profile>
  </qos_library>

  <persistence_service name="transient">
    <participant name="transientParticipant">
      <domain_id>0</domain_id>
      <participant_qos base_name="CoexistenceQosLib::LoopbackQos"/>
      <persistence_group name="transientAll">
        <filter>*</filter>
        <single_publisher>true</single_publisher>
        <single_subscriber>true</single_subscriber>
      </persistence_group>
    </participant>
  </persistence_service>

</dds>
