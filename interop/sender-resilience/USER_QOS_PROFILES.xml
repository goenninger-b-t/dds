<?xml version="1.0"?>
<!-- LOOPBACK-ONLY profile for the WP-SENDER-ERROR-RESILIENCE interop DoD (FR-PF-2). The
     Connext shapes_sub is run from THIS directory so it picks up this profile from cwd:
     allow_interfaces is pinned to 127.0.0.1 (NOT the LAN address) so Connext binds +
     advertises ONLY the loopback locator and every RTPS byte rides lo0. This stack reaches
     the peer with unicast SPDP to 127.0.0.1:7410 (PEERS=127.0.0.1:7410). Loopback is exempt
     from the macOS application-firewall LAN-UDP drop, and keeping the wire on lo0 makes the
     RTPS exchange observable to tshark. SHMEM dropped (UDPv4 only) so no data-sharing path
     hides the wire. Mirrors interop/connext/nokey/USER_QOS_PROFILES.xml. Capture aid; not CI. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.1/rti_dds_qos_profiles.xsd">
  <qos_library name="InteropOracle">
    <qos_profile name="SingleIfaceUDP" is_default_qos="true">
      <participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>
        </transport_builtin>
        <property>
          <value>
            <element>
              <name>dds.transport.UDPv4.builtin.parent.allow_interfaces</name>
              <value>127.0.0.1</value>
            </element>
          </value>
        </property>
      </participant_qos>
    </qos_profile>
  </qos_library>
</dds>
