<?xml version="1.0"?>
<!-- host_id isolation: the three buffer properties are held CONSTANT across all
     profiles, so any change in the 12-byte address at segment offset 0x24 is
     attributable to host_id alone. Values chosen to be byte-distinctive and
     safely below INT_MAX. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <qos_library name="HostIdLib">

    <qos_profile name="H_01020304">
      <domain_participant_qos>
        <transport_builtin><mask>UDPv4 | SHMEM</mask></transport_builtin>
        <property><value>
          <element><name>dds.transport.shmem.builtin.received_message_count_max</name><value>37</value></element>
          <element><name>dds.transport.shmem.builtin.receive_buffer_size</name><value>777216</value></element>
          <element><name>dds.transport.shmem.builtin.parent.message_size_max</name><value>20480</value></element>
          <element><name>dds.transport.shmem.builtin.host_id</name><value>16909060</value></element>
        </value></property>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="H_00000001">
      <domain_participant_qos>
        <transport_builtin><mask>UDPv4 | SHMEM</mask></transport_builtin>
        <property><value>
          <element><name>dds.transport.shmem.builtin.received_message_count_max</name><value>37</value></element>
          <element><name>dds.transport.shmem.builtin.receive_buffer_size</name><value>777216</value></element>
          <element><name>dds.transport.shmem.builtin.parent.message_size_max</name><value>20480</value></element>
          <element><name>dds.transport.shmem.builtin.host_id</name><value>1</value></element>
        </value></property>
      </domain_participant_qos>
    </qos_profile>

    <qos_profile name="H_NONE">
      <domain_participant_qos>
        <transport_builtin><mask>UDPv4 | SHMEM</mask></transport_builtin>
        <property><value>
          <element><name>dds.transport.shmem.builtin.received_message_count_max</name><value>37</value></element>
          <element><name>dds.transport.shmem.builtin.receive_buffer_size</name><value>777216</value></element>
          <element><name>dds.transport.shmem.builtin.parent.message_size_max</name><value>20480</value></element>
        </value></property>
      </domain_participant_qos>
    </qos_profile>

  </qos_library>
</dds>
