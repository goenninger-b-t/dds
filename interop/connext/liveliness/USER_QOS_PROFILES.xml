<?xml version="1.0"?>
<!-- LOOPBACK-ONLY, SHORT-LEASE profile for the live Writer-Liveliness-Protocol /
     participant-lease-expiry test against this stack's DCPS harness (FR-DCPS S2).
     allow_interfaces is pinned to 127.0.0.1 so shapes_pub binds + advertises ONLY the
     loopback locator and every RTPS byte rides lo0 (sidesteps the macOS application
     firewall, which drops LAN-sourced UDP for unapproved binaries; loopback is exempt).
     The Lisp side reaches this peer with unicast SPDP to 127.0.0.1:7410.
     participant_liveliness_lease_duration is shortened to 12 s (assert period 4 s) so a
     killed participant is pruned by our %lease-sweep within ~12 s instead of the 100 s
     default. SHMEM dropped (UDPv4 only) so the wire stays observable. Capture-only; not CI. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.1/rti_dds_qos_profiles.xsd">
  <qos_library name="InteropOracle">
    <qos_profile name="LoopbackShortLease" is_default_qos="true">
      <participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>
        </transport_builtin>
        <discovery>
          <initial_peers>
            <element>127.0.0.1</element>
          </initial_peers>
          <multicast_receive_addresses/>
        </discovery>
        <discovery_config>
          <participant_liveliness_lease_duration>
            <sec>12</sec>
            <nanosec>0</nanosec>
          </participant_liveliness_lease_duration>
          <participant_liveliness_assert_period>
            <sec>4</sec>
            <nanosec>0</nanosec>
          </participant_liveliness_assert_period>
        </discovery_config>
        <property>
          <value>
            <element>
              <name>dds.transport.UDPv4.builtin.parent.allow_interfaces</name>
              <value>127.0.0.1</value>
            </element>
          </value>
        </property>
      </participant_qos>
    </qos_profile>
  </qos_library>
</dds>
