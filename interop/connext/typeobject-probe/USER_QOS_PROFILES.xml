<?xml version="1.0"?>
<!-- Forces typeobject-probe discovery onto loopback UDPv4 ONLY, so SEDP DATA(w)
     (carrying PID_TYPE_INFORMATION / the EquivalenceHash) is visible to tshark on lo0.
     Default Connext same-host discovery prefers SHMEM, which never hits the wire.
     Auto-loaded by Connext from the CWD. Capture-only aid; not built/run by CI. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.1/rti_dds_qos_profiles.xsd">
  <qos_library name="InteropOracle">
    <qos_profile name="LoopbackUDPOnly" is_default_qos="true">
      <participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>
        </transport_builtin>
        <discovery>
          <initial_peers>
            <element>udpv4://127.0.0.1</element>
          </initial_peers>
          <multicast_receive_addresses/>
        </discovery>
        <property>
          <value>
            <element>
              <name>dds.transport.UDPv4.builtin.parent.allow_interfaces</name>
              <value>127.0.0.1</value>
            </element>
          </value>
        </property>
      </participant_qos>
    </qos_profile>
  </qos_library>
</dds>
