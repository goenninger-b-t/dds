<?xml version="1.0"?>
<!-- APP-ACK capture profile (ADR 0090).

     TWO jobs. (1) Force the whole exchange onto loopback UDPv4, because Connext prefers SHMEM for
     same-host traffic and SHMEM never reaches the wire, so tshark would see nothing at all. (2) Turn on
     APPLICATION acknowledgment on BOTH sides — it is an RxO-style pair, so a writer alone changes
     nothing observable.

     APPLICATION_AUTO is used rather than APPLICATION_EXPLICIT on purpose: it acknowledges when the
     subscriber accesses the sample through an ordinary read/take, so the capture needs no
     vendor-extension API call in the peer and nothing about the C++ binding has to be guessed at. The
     wire exchange (APP_ACK 0x1c / APP_ACK_CONF 0x1d) is the same mechanism either way.

     Capture-only aid for ADR 0090; not built or run by CI. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.1/rti_dds_qos_profiles.xsd">
  <qos_library name="AppAckCapture">
    <qos_profile name="LoopbackAppAck" is_default_qos="true">
      <participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>
        </transport_builtin>
        <discovery>
          <initial_peers>
            <element>udpv4://127.0.0.1</element>
          </initial_peers>
          <multicast_receive_addresses/>
        </discovery>
        <property>
          <value>
            <element>
              <name>dds.transport.UDPv4.builtin.parent.allow_interfaces</name>
              <value>127.0.0.1</value>
            </element>
          </value>
        </property>
      </participant_qos>

      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
          <acknowledgment_kind>APPLICATION_AUTO_ACKNOWLEDGMENT_MODE</acknowledgment_kind>
        </reliability>
        <history>
          <kind>KEEP_ALL_HISTORY_QOS</kind>
        </history>
      </datawriter_qos>

      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
          <acknowledgment_kind>APPLICATION_AUTO_ACKNOWLEDGMENT_MODE</acknowledgment_kind>
        </reliability>
        <history>
          <kind>KEEP_ALL_HISTORY_QOS</kind>
        </history>
      </datareader_qos>
    </qos_profile>
  </qos_library>
</dds>
