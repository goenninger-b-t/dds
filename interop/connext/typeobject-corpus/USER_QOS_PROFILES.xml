<?xml version="1.0"?>
<!-- Pins corpus_pub's Connext participants to UDPv4 on the box's real interface
     (en7 / 192.168.2.148, mirroring shapes-pub/large-data) PLUS loopback (127.0.0.1), and
     drops SHMEM. Rationale: this stack's `make corpus-capture` subscriber egresses its
     multicast SPDP (239.255.0.1) on en7 (the default multicast route) but advertises its
     unicast metatraffic locator as 127.0.0.1. So Connext must (a) receive multicast SPDP on
     en7 to discover the subscriber and (b) be able to send unicast SEDP DATA(w) — carrying
     RTI's proprietary legacy TypeObject / PID_TYPE_OBJECT_LB 0x8021 — to 127.0.0.1, which
     the subscriber's 0.0.0.0-bound socket receives. Allowing both interfaces satisfies both.
     Multicast SPDP left ENABLED so the foreign peer discovers via 239.255.0.1.
     Auto-loaded by Connext from the CWD. Capture-only aid; not built/run by CI. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.1/rti_dds_qos_profiles.xsd">
  <qos_library name="InteropOracle">
    <qos_profile name="SingleIfaceUDP" is_default_qos="true">
      <participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>
        </transport_builtin>
        <property>
          <value>
            <element>
              <name>dds.transport.UDPv4.builtin.parent.allow_interfaces</name>
              <value>192.168.2.148,127.0.0.1</value>
            </element>
          </value>
        </property>
      </participant_qos>
    </qos_profile>
  </qos_library>
</dds>
