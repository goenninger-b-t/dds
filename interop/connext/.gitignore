# rtiddsgen-generated type support (clean-room: produced at build time, never committed)
ShapeType.hpp
ShapeType.cxx
ShapeTypePlugin.hpp
ShapeTypePlugin.cxx
LargeData.hpp
LargeData.cxx
LargeDataPlugin.hpp
LargeDataPlugin.cxx
Corpus.hpp
Corpus.cxx
CorpusPlugin.hpp
CorpusPlugin.cxx
NoKeyData.hpp
NoKeyData.cxx
NoKeyDataPlugin.hpp
NoKeyDataPlugin.cxx
*.idl.*
.gen.stamp

# build artifacts
*.o
*.so
*.dylib

# the built executables
typeobject-probe/typeobject_probe
shapes-pub/shapes_pub
shapes-sub/shapes_sub
cdr-capture/cdr_capture
large-data/large_pub
large-data/large_sub
typeobject-corpus/corpus_pub
nokey/nokey_pub
nokey/nokey_sub

# transient capture artifacts (pcaps + tshark decodes produced while probing)
*.pcap
*.pcapng
decode.txt
decode.err
tshark.err
*.out

# ADR 0090 APP-ACK capture is kept: application acknowledgment has NO OMG clause, so this pcap and its
# decode ARE the specification the codec will be written against. A wire finding nobody can re-read is
# not evidence, so these are deliberately exempt from the transient-artifact sweep above.
!appack/captures/
!appack/captures/*.pcap
!appack/captures/*.txt
!appack/captures/*.py

# archived no-key interop proof captures are kept (force-added under nokey/captures/)
!nokey/captures/
!nokey/captures/*.pcap
!nokey/captures/*.log

# mutable corpus peer (ADR 0086) — rtiddsgen output is produced at build time, never committed
MutableData.hpp
MutableData.cxx
MutableDataPlugin.hpp
MutableDataPlugin.cxx
mutable/mutable_pub
mutable/mutable_sub

# RTI dylib symlinks placed next to the binary: the libs are installed with an @loader_path
# install name, which DYLD_LIBRARY_PATH cannot satisfy (same fix as interop/perftest/connext).
mutable/*.dylib

# deadline peer (cross-vendor REQUESTED_DEADLINE_MISSED)
ShapeType.hpp
deadline/deadline_pub

# durability peer (TRANSIENT_LOCAL late-joiner replay)
durability/durable_pub

# liveliness peer (writer-liveliness lease expiry)
liveliness-peer/liveliness_pub
