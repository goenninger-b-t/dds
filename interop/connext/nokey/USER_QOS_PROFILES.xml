<?xml version="1.0"?>
<!-- LOOPBACK-ONLY profile for same-host interop with this stack's no-key DCPS harness.
     allow_interfaces is pinned to 127.0.0.1 (NOT the LAN address) so the Connext nokey
     apps bind+advertise ONLY the loopback locator and every RTPS byte rides lo0. This
     sidesteps the macOS application firewall / local network privacy layer, which
     silently drops LAN-sourced inbound UDP for a freshly built, unapproved binary (the
     nokey_pub / nokey_sub here are absent from the firewall allow list, unlike the long
     approved shapes_pub / shapes_sub); loopback traffic is exempt. The Lisp side reaches
     this peer with unicast SPDP to 127.0.0.1:7410 (PEERS=127.0.0.1:7410). Mirrors the
     Fast DDS leg B loopback resolution (interop/fastdds/type_probe/profiles.xml).
     SHMEM dropped (UDPv4 only) so the wire stays observable. Capture-only; not CI. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.1/rti_dds_qos_profiles.xsd">
  <qos_library name="InteropOracle">
    <qos_profile name="SingleIfaceUDP" is_default_qos="true">
      <participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>
        </transport_builtin>
        <property>
          <value>
            <element>
              <name>dds.transport.UDPv4.builtin.parent.allow_interfaces</name>
              <value>127.0.0.1</value>
            </element>
          </value>
        </property>
      </participant_qos>
    </qos_profile>
  </qos_library>
</dds>
