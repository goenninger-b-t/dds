<?xml version="1.0"?>
<!-- Forces RTPS-level fragmentation for the DATA_FRAG oracle: UDPv4-only (no SHMEM, or
     nothing appears on lo0 between two same-host Connext apps), pinned to one interface
     (en7 / 192.168.2.148, mirroring the shapes profiles; same-host unicast still routes
     over lo0), and builtin-UDPv4 message_size_max=1400 so a multi-KB LargeData sample
     cannot fit one datagram and Connext must emit DATA_FRAG.
     Capture-only aid; not built/run by CI. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.1/rti_dds_qos_profiles.xsd">
  <qos_library name="InteropOracle">
    <qos_profile name="FragmentingUDP" is_default_qos="true">
      <participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>
        </transport_builtin>
        <property>
          <value>
            <element>
              <name>dds.transport.UDPv4.builtin.parent.allow_interfaces</name>
              <value>192.168.2.148</value>
            </element>
            <element>
              <name>dds.transport.UDPv4.builtin.parent.message_size_max</name>
              <value>1400</value>
            </element>
          </value>
        </property>
      </participant_qos>
      <!-- Connext refuses reliable fragmented data on a synchronous writer
           ("Reliable fragmented data requires asynchronous writer"). -->
      <datawriter_qos>
        <publish_mode>
          <kind>ASYNCHRONOUS_PUBLISH_MODE_QOS</kind>
        </publish_mode>
      </datawriter_qos>
    </qos_profile>
  </qos_library>
</dds>
