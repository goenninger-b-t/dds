<?xml version="1.0"?>
<!-- Pins Connext shapes-pub to a single UDPv4 interface (en7 / 192.168.2.148) and drops
     SHMEM, so it advertises ONE reachable locator. Otherwise Connext also advertises VPN /
     link-local addresses (10.x, 169.254.x) and a foreign-vendor peer may resolve an
     unreachable one, stalling the reliable SEDP handshake. Multicast SPDP is left ENABLED
     (the foreign peer discovers via 239.255.0.1). Capture-only aid; not built/run by CI. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.1/rti_dds_qos_profiles.xsd">
  <qos_library name="InteropOracle">
    <qos_profile name="SingleIfaceUDP" is_default_qos="true">
      <participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>
        </transport_builtin>
        <property>
          <value>
            <element>
              <name>dds.transport.UDPv4.builtin.parent.allow_interfaces</name>
              <value>192.168.2.148</value>
            </element>
          </value>
        </property>
      </participant_qos>
    </qos_profile>
  </qos_library>
</dds>
