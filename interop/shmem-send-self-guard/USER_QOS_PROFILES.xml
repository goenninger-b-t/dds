<?xml version="1.0"?>
<!-- LOOPBACK-ONLY profile for the SHMEM-send self-guard no-regression interop
     (WP-SHMEM-SEND-SELF-GUARD, FR-XPORT-2). allow_interfaces is pinned to 127.0.0.1 (NOT a
     LAN address) so the Connext shapes_sub binds+advertises ONLY the loopback locator and
     every RTPS byte rides lo0. This sidesteps both the macOS "network interfaces can change"
     participant-index-init failure (a stale pinned LAN interface) and the macOS application
     firewall / local-network-privacy layer. The Lisp side reaches this peer with unicast SPDP
     to 127.0.0.1:7410 (PEERS=127.0.0.1:7410 ADVERTISE=127.0.0.1). SHMEM is dropped (UDPv4
     only) so the wire stays observable — which is exactly the point here: a FOREIGN peer always
     receives our user DATA over UDP, never SHMEM (the self-guard is inert for it), so this leg
     is no-regression. Mirrors interop/keyed-flatdata/connext/USER_QOS_PROFILES.xml. Capture-only
     aid; not built or run by CI. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.1/rti_dds_qos_profiles.xsd">
  <qos_library name="InteropOracle">
    <qos_profile name="SingleIfaceUDP" is_default_qos="true">
      <participant_qos>
        <transport_builtin>
          <mask>UDPv4</mask>
        </transport_builtin>
        <property>
          <value>
            <element>
              <name>dds.transport.UDPv4.builtin.parent.allow_interfaces</name>
              <value>127.0.0.1</value>
            </element>
          </value>
        </property>
      </participant_qos>
    </qos_profile>
  </qos_library>
</dds>
